{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start CPRI Server",
      "type": "shell",
      "command": "node",
      "args": ["server/launcher.js"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "cpri-server",
          "severity": "info",
          "pattern": { "regexp": "^.*$", "file": 0 },
          "background": {
            "beginsPattern": "^Starting CPRI server on http://localhost:\\d+\\.\\.\\.",
            "endsPattern": "^CPRI public website running at http://localhost:\\d+"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "type": "npm",
      "script": "dev",
      "problemMatcher": [],
      "label": "npm: dev",
      "detail": "node --watch server/server.js"
    }
  ]
}

