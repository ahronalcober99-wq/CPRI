{
  "name": "cpri-public-website",
  "version": "1.0.0",
  "description": "CPRI Public Website Module - public information pages for the Center for Policy and Research Innovations",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "share": "node server/share.mjs",
    "share:setup": "node server/share.mjs --setup",
    "backup": "node server/backup.mjs",
    "seed": "node server/server/seed.mjs",
    "seed:demo": "node server/server/seed-demo.mjs",
    "seed:demo:clear": "node server/server/seed-demo.mjs --clear",
    "migrate": "node server/server/seed.mjs",
    "test:dropdowns": "node server/dev/test-dropdowns.mjs",
    "test:phone": "node --test server/dev/test-phone-verification.mjs",
    "test:repository": "node --test server/dev/test-repository-delete.mjs server/dev/test-repository-files.mjs",
    "check:api": "node server/dev/check-api.mjs",
    "doctor": "node server/dev/db-doctor.mjs",
    "db:init": "node server/dev/db-init.mjs",
    "purge:sessions": "node server/session-purge.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.3",
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.0.2",
    "bcryptjs": "^2.4.3",
    "bmp-js": "^0.1.0",
    "compression": "^1.8.2",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^1.0.0-beta.22",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.0",
    "file-type": "^21.3.4",
    "heic-convert": "^2.1.0",
    "helmet": "^8.3.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.0",
    "session-file-store": "^1.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "drizzle-kit": "^1.0.0-beta.22"
  }
}
