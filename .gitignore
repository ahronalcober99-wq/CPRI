node_modules/
.tools/
server/data/*.json
# Shipped on purpose: seeds an empty `courses` table at boot (server/lib/courses.js).
!server/data/courses-seed.json
server/data/demo-access.key
server/data/sessions/
# Uploaded research documents (Research Submission Module) — private, and never
# served from a public folder. Only the download endpoint may read them.
server/data/research-submissions/
backups/
public/assets/uploads/
*.log
.env
# Staging database credentials (node --env-file=.env.staging server/server.js)
.env.staging

# Local machine state / credentials — must never be committed.
# `git add .` used to sweep these in accidentally (Chrome test profile with the
# browser's saved logins and cookies, the Freebuff app database, cookie jars).
# `run.md` is the one .freebuff file worth keeping, so re-include it.
.freebuff/*
!.freebuff/run.md
public/.freebuff/
cookies.txt

# Private database dumps (real user records) — db/schema.sql is the tracked one.
cpri-data.sql
*.data.sql
