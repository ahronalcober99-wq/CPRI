# ─────────────────────────────────────────────────────────────
# CPRI Environment Variables — copy this file to `.env`
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# MySQL database (same defaults as the app)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cpri
DB_POOL_LIMIT=10

# ─────────────────────────────────────────────────────────────
# Gmail SMTP — used to send verification codes + password resets
#
# ⚠️  IMPORTANT — DO NOT use your real Gmail password here.
#
# Gmail requires an "App Password" for third-party apps. To generate one:
#   1. Enable 2-Step Verification on your Google Account FIRST:
#        Google Account → Security → 2-Step Verification
#      ⚠️  The "App passwords" option only appears AFTER 2-Step Verification
#          is enabled. Without it, Gmail will silently reject login with
#          "Invalid login" or "Application-specific password required".
#   2. Go to: Google Account → Security → App passwords
#      (https://myaccount.google.com/apppasswords)
#   3. Select app "Mail" + device "Other" (e.g., "CPRI Server"), click Generate.
#   4. Google will show a 16-character password like: abcd efgh ijkl mnop
#      Copy it (spaces optional) into GMAIL_APP_PASSWORD below.
#   5. Do NOT share it, and do NOT commit it to git. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────
GMAIL_USER=Ahronalcober99@gmail.com
GMAIL_APP_PASSWORD=oror pcxk zbnp zior

# Optional: sender name shown in verification emails (default "CPRI").
MAIL_FROM_NAME=CPRI

# ─────────────────────────────────────────────────────────────
# Google OAuth — "Continue with Google" / Gmail sign-in
#
# One-click sign-in with a Gmail/Google account (login + register pages).
# Leave both values EMPTY to keep the button visible but inactive (it shows
# a friendly "not configured" notice instead of failing).
#
# To enable real sign-in:
#   1. Go to https://console.cloud.google.com and create a project (or reuse one).
#   2. APIs & Services → OAuth consent screen → External → fill in the app info
#      (app name, support email, developer contact).
#   3. APIs & Services → Credentials → Create credentials → OAuth client ID
#      → Web application.
#      • "Authorized JavaScript origins": your site origin, e.g.
#          http://localhost:3000
#      • "Authorized redirect URIs" — the exact callback path on EVERY host the
#        app runs on, e.g.:
#          http://localhost:3000/api/auth/google/callback
#          https://<your-tunnel>.trycloudflare.com/api/auth/google/callback
#   4. Copy the Client ID and Client secret into the two lines below.
#   5. Restart the server — the button becomes active automatically.
#
# Advanced / testing only — override the OAuth endpoints (they default to
# Google's production URLs). Used to run the flow against a local mock provider:
#   GOOGLE_AUTH_URL=http://localhost:3200/o/oauth2/v2/auth
#   GOOGLE_TOKEN_URL=http://localhost:3200/token
#   GOOGLE_USERINFO_URL=http://localhost:3200/userinfo
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
