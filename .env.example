# ─────────────────────────────────────────────────────────────
# CPRI Environment Variables — copy this file to `.env`
#   cp .env.example .env
#
# ⚠️  This file is COMMITTED to Git. Never put a real value in it — only
#     placeholders. Real secrets belong in `.env`, which is gitignored.
# ─────────────────────────────────────────────────────────────

# MySQL database (same defaults as the app)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cpri
DB_SSL=false
DB_POOL_LIMIT=10

# Optional TLS controls — only needed when the defaults do not fit your host.
#   DB_SSL_MODE  auto (default) | require | disable
#     auto     TLS for any non-localhost host (what DB_SSL=false implies)
#     require  always use TLS
#     disable  never use TLS (for hosts that do not offer it)
#   DB_SSL_CA    the provider's CA certificate, when it signs with its own CA
#                (Aiven, Clever Cloud, …). Accepts PEM text — with real
#                newlines or escaped "\n" — or a path to a .pem file.
#   DB_SSL_REJECT_UNAUTHORIZED=false  keep TLS but skip the certificate check.
#DB_SSL_MODE=
#DB_SSL_CA=
#DB_SSL_REJECT_UNAUTHORIZED=

# ─────────────────────────────────────────────────────────────
# Gmail SMTP — used to send verification codes + password resets
#
# ⚠️  IMPORTANT — DO NOT use your real Gmail password here.
#
# Gmail requires an "App Password" for third-party apps. To generate one:
#   1. Enable 2-Step Verification on your Google Account FIRST:
#        Google Account → Security → 2-Step Verification
#      ⚠️  The "App passwords" option only appears AFTER 2-Step Verification
#          is enabled. Without it, Gmail will silently reject login with
#          "Invalid login" or "Application-specific password required".
#   2. Go to: Google Account → Security → App passwords
#      (https://myaccount.google.com/apppasswords)
#   3. Select app "Mail" + device "Other" (e.g., "CPRI Server"), click Generate.
#   4. Google will show a 16-character password like: abcd efgh ijkl mnop
#      Copy it (spaces optional) into GMAIL_APP_PASSWORD in `.env`.
#   5. Do NOT share it, and do NOT commit it to git. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Optional: sender name shown in verification emails (default "CPRI").
MAIL_FROM_NAME=CPRI

# ─────────────────────────────────────────────────────────────
# Google OAuth — "Continue with Google" / Gmail sign-in
#
# One-click sign-in with a Gmail/Google account (login + register pages).
# Leave both values EMPTY to keep the button visible but inactive (it shows
# a friendly "not configured" notice instead of failing).
#
# To enable real sign-in:
#   1. Go to https://console.cloud.google.com and create a project (or reuse one).
#   2. APIs & Services → OAuth consent screen → External → fill in the app info
#      (app name, support email, developer contact).
#   3. APIs & Services → Credentials → Create credentials → OAuth client ID
#      → Web application.
#      • "Authorized JavaScript origins": your site origin, e.g.
#          http://localhost:3000
#      • "Authorized redirect URIs" — the exact callback path on EVERY host the
#        app runs on, e.g.:
#          http://localhost:3000/api/auth/google/callback
#          https://<your-api-host>/api/auth/google/callback
#   4. Copy the Client ID and Client secret into the two lines below (in `.env`).
#   5. Restart the server — the button becomes active automatically.
#
# Advanced / testing only — override the OAuth endpoints (they default to
# Google's production URLs). Used to run the flow against a local mock provider:
#   GOOGLE_AUTH_URL=http://localhost:3200/o/oauth2/v2/auth
#   GOOGLE_TOKEN_URL=http://localhost:3200/token
#   GOOGLE_USERINFO_URL=http://localhost:3200/userinfo
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# Deploying the API for the GitHub Pages front end
# ─────────────────────────────────────────────────────────────
# Port the Express server listens on. Most hosts (Render, Railway, Fly,
# Heroku) inject their own PORT — leave this commented there.
#PORT=3000

# Secret used to sign session cookies. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Comma-separated list of front-end origins allowed to call this API with
# cookies. Setting it turns on CORS + cross-site session cookies, which
# browsers only accept over HTTPS. Example:
#   CORS_ORIGINS=https://ahronalcober99-wq.github.io
#CORS_ORIGINS=

# Set to 1 when the API runs behind a reverse proxy / load balancer that
# terminates TLS, so Express sees the original https scheme and can mark the
# session cookie Secure. Not needed for a local `npm start`.
#TRUST_PROXY=1
